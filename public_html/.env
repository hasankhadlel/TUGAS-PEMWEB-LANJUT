# Konfigurasi Aplikasi
APP_NAME="SINTAKSIS PMII UIN SGD Bandung"
APP_ENV=local
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE # Ganti dengan kunci unik yang kuat (misalnya, hasil dari perintah framework)
APP_DEBUG=true # Atur ke 'false' di lingkungan produksi untuk keamanan
APP_URL=http://localhost:8000 # URL dasar aplikasi Anda (misalnya, http://localhost:8000 atau https://yourdomain.com)

# Konfigurasi Database MySQL
DB_CONNECTION=mysql
DB_HOST=127.0.0.1 # Biasanya 'localhost' atau IP database Anda
DB_PORT=3306     # Port default MySQL
DB_DATABASE=pmii_uin_bandung # Nama database yang telah kita buat
DB_USERNAME=root # Username database Anda (misalnya 'root' untuk lokal)
DB_PASSWORD= # Password database Anda (biarkan kosong jika tidak ada password, atau isi password Anda)

# Konfigurasi Layanan Email (SMTP) - Opsional, jika Anda ingin fitur pengiriman email berfungsi
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io # Contoh: 'smtp.mailtrap.io' untuk testing, atau SMTP server asli Anda
MAIL_PORT=2525 # Port SMTP
MAIL_USERNAME=null # Username SMTP Anda
MAIL_PASSWORD=null # Password SMTP Anda
MAIL_ENCRYPTION=tls # atau 'ssl' atau 'null'
MAIL_FROM_ADDRESS="noreply@pmii-sintaksis.com"
MAIL_FROM_NAME="${APP_NAME}"

# Konfigurasi Layanan Penyimpanan File (Opsional)
# Jika Anda menggunakan layanan cloud storage seperti AWS S3 atau Google Cloud Storage
FILESYSTEM_DRIVER=local # Default: lokal. Ganti ke 's3' atau 'gcs' jika menggunakan cloud storage

# AWS S3 (Contoh jika FILESYSTEM_DRIVER=s3)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_DEFAULT_REGION=ap-southeast-1 # Contoh: sg
# AWS_BUCKET=your_s3_bucket_name
# AWS_URL=null
# AWS_ENDPOINT=null

# Konfigurasi Integrasi OJS (Open Journal Systems) - Opsional
# OJS_BASE_URL=https://jurnal.pmii-uin.ac.id
# OJS_API_KEY=your_ojs_api_key
# OJS_ADMIN_USERNAME=your_ojs_admin_username
# OJS_ADMIN_PASSWORD=your_ojs_admin_password # Pastikan ini dienkripsi jika disimpan di DB

# Konfigurasi Layanan WhatsApp API - Opsional
# WHATSAPP_API_URL=https://api.whatsapp.com/send
# WHATSAPP_API_KEY=your_whatsapp_api_key
# WHATSAPP_SENDER_ID=your_whatsapp_sender_id

# Kunci API Eksternal Lainnya (jika ada)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
